<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="1"
    android:background="@drawable/castle2"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="453dp"
        android:layout_height="74dp"
        android:fontFamily="cursive"
        android:shadowColor="#891C1C"
        android:shadowDx="3"
        android:shadowDy="2"
        android:shadowRadius="@dimen/material_emphasis_disabled"
        android:text="Grimm Brothers Tales"
        android:textAlignment="center"
        android:textColor="#891C1C"
        android:textSize="48sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.542"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.056" />

    <EditText
        android:id="@+id/usernameEditText"
        android:layout_width="318dp"
        android:layout_height="49dp"
        android:background="#D4F0F0F0"
        android:ems="10"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.422" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="426dp"
        android:layout_height="93dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.502"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.838">

        <Button
            android:id="@+id/signUpButton"
            android:layout_width="170dp"
            android:layout_height="70dp"
            android:layout_marginEnd="24dp"
            android:backgroundTint="#891C1C"
            android:fontFamily="cursive"
            android:onClick="signUp"
            android:text="Sign Up"
            android:textAlignment="center"
            android:textColor="#F0F0F0"
            android:textColorHighlight="#F0F0F0"
            android:textColorHint="#F0F0F0"
            android:textColorLink="#F0F0F0"
            android:textSize="24sp"
            android:textStyle="bold"
            app:icon="@drawable/hydra"
            app:iconTint="#F0F0F0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="#F0F0F0" />

        <Button
            android:id="@+id/signInButton"
            android:layout_width="170dp"
            android:layout_height="70dp"
            android:backgroundTint="#891C1C"
            android:fontFamily="cursive"
            android:onClick="signIn"
            android:text="Sign In"
            android:textAlignment="center"
            android:textColor="#F0F0F0"
            android:textColorHighlight="#F0F0F0"
            android:textColorHint="#F0F0F0"
            android:textColorLink="#F0F0F0"
            android:textSize="24sp"
            android:textStyle="bold"
            app:icon="@drawable/wizard"
            app:iconTint="#F0F0F0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/signUpButton"
            app:layout_constraintHorizontal_bias="0.435"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.478"
            app:rippleColor="#F0F0F0" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <EditText
        android:id="@+id/passwordEditText"
        android:layout_width="321dp"
        android:layout_height="49dp"
        android:background="#D4F0F0F0"
        android:ems="10"
        android:hint="Password"
        android:inputType="textPassword"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayout"
        app:layout_constraintTop_toBottomOf="@+id/usernameEditText"
        app:layout_constraintVertical_bias="0.374"
        tools:layout_editor_absoluteX="119dp" />

    <TextView
        android:id="@+id/textViewIntro"
        android:layout_width="493dp"
        android:layout_height="82dp"
        android:background="@color/white"
        android:backgroundTint="#4EF0F0F0"
        android:fontFamily="serif"
        android:text="Please enter your e-mail and Password to Sign in "
        android:textAlignment="center"
        android:textColor="#000000"
        android:textColorLink="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="normal|bold"
        app:layout_constraintBottom_toTopOf="@+id/usernameEditText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.507"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView"
        app:layout_constraintVertical_bias="0.705" />


</androidx.constraintlayout.widget.ConstraintLayout>